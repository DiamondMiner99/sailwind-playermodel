<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SailwindPlayerModel</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)/BepInEx/core/BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)/BepInEx/core/0Harmony.dll</HintPath>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)/Sailwind_Data/Managed/UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)/Sailwind_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <!-- CharacterController geometry + the fit-time ground raycast. -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameDir)/Sailwind_Data/Managed/UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <!-- TextMesh for the name tag. Sailwind has no TextMeshPro. -->
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)/Sailwind_Data/Managed/UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <!-- GUIStyle / GUI, for the parchment panels. -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameDir)/Sailwind_Data/Managed/UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <!-- Animator: BodyTemplate.Strip removes it, which is why every pose here is procedural. -->
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameDir)/Sailwind_Data/Managed/UnityEngine.AnimationModule.dll</HintPath>
    </Reference>

    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)/Sailwind_Data/Managed/Assembly-CSharp.dll</HintPath>
    </Reference>
    <!-- Refs.ovrCameraRig is an OVRCameraRig. -->
    <Reference Include="Oculus.VR">
      <HintPath>$(GameDir)/Sailwind_Data/Managed/Oculus.VR.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
